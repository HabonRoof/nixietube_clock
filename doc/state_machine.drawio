<mxfile host="app.diagrams.net">
  <diagram id="buttons" name="按鍵分流">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="短按之後的判斷順序" style="text;html=1;fontSize=22;fontStyle=1;align=left;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="420" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="src" value="對照 SystemController::handle_button_press。上面的判斷先成立就直接返回，不會再換模式或設定檔。長按 BTN1+BTN2 三秒由 InputDaemon 另外處理，不進入這條鏈；組合按住期間，這兩顆鍵的短按不會送出。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff9e6;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="980" y="24" width="560" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="start" value="短按" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="250" y="70" width="140" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="d1" value="BTN0，而且鬧鐘正在響？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="180" y="170" width="280" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="o1" value="停止鬧鐘。這次按鍵結束。&lt;br&gt;曲目最長循環 180 秒。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="560" y="185" width="280" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="d2" value="休眠中，而且鬧鐘沒有在響？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="180" y="330" width="280" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="o2" value="進入 Peek。見「休眠與待機」。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="560" y="345" width="280" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="d3" value="正在 Peek？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="180" y="490" width="280" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="o3" value="把 5 秒倒數重設。不換模式。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="560" y="505" width="280" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="d4" value="待機變暗中？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="180" y="640" width="280" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="o4" value="恢復設定檔亮度。留在時鐘模式。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="560" y="655" width="280" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="d5" value="設定熱點開著？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="180" y="790" width="280" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="o5" value="忽略這次短按。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="560" y="805" width="280" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="d6" value="哪一顆鍵？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="180" y="940" width="280" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="b0" value="BTN0　GPIO 8&lt;br&gt;番茄鐘且還在等待：開始工作&lt;br&gt;發散計：重新亂跳&lt;br&gt;其他模式：沒有動作" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="1120" width="300" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="b1" value="BTN1　GPIO 12&lt;br&gt;循環顯示模式&lt;br&gt;見「顯示模式」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="380" y="1120" width="260" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="b2" value="BTN2　GPIO 13&lt;br&gt;番茄鐘：忽略&lt;br&gt;其他：下一組燈光設定檔&lt;br&gt;若網頁正在預覽，先取消預覽" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="680" y="1120" width="320" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="pins" value="三顆鍵都是低電位有效。BTN1 是模式，BTN2 短按是設定檔。設定檔有 4 組，0 到 3 循環，並寫入 NVS。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff9e6;strokeColor=#d6b656;align=left;spacingLeft=8;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1040" y="1120" width="500" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontFamily=Helvetica;fontSize=12;" edge="1" parent="1" source="start" target="d1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e1y" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d1" target="o1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e1n" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d1" target="d2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2y" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d2" target="o2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2n" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d2" target="d3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3y" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d3" target="o3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3n" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d3" target="d4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4y" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d4" target="o4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4n" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d4" target="d5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5y" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d5" target="o5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5n" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d5" target="d6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6a" value="BTN0" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d6" target="b0">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6b" value="BTN1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d6" target="b1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6c" value="BTN2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d6" target="b2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="modes" name="顯示模式">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="顯示模式　BTN1 循環" style="text;html=1;fontSize=22;fontStyle=1;align=left;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="480" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="boot" value="開機" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="90" y="80" width="120" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="clock" value="CLOCK_HHMMSS&lt;br&gt;時鐘 HHMMSS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="date" value="DATE_YYMMDD&lt;br&gt;日期 YYMMDD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="340" y="190" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="pomo" value="POMODORO&lt;br&gt;番茄鐘" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="640" y="190" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="div" value="DIVERGENCE_METER&lt;br&gt;發散計" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="940" y="190" width="230" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="cath" value="CATHODE_POISONING&lt;br&gt;陰極防護" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1250" y="190" width="240" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="manual" value="MANUAL_DISPLAY&lt;br&gt;CLI：set_nixie" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="off" value="OFF&lt;br&gt;休眠關掉燈管。見「休眠與待機」。不在 BTN1 循環裡。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="340" y="500" width="280" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="config" value="CONFIG_CODE&lt;br&gt;設定熱點的四位連線碼。見「設定熱點」。不在 BTN1 循環裡。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="680" y="500" width="320" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="note" value="實線是 BTN1。虛線是時間到了自動回到時鐘。&lt;br&gt;日期、發散計都是 10 秒後返回。陰極防護是 15 步、每步 300 ms（4.5 秒）後返回。&lt;br&gt;每 15 分鐘，若目前是時鐘、日期或手動顯示，而且鬧鐘沒有在響，會自動進入陰極防護。若當時在番茄鐘、發散計、陰極防護或關閉，時間到了也不開始，離開那些模式後才補跑。&lt;br&gt;用 BTN1 離開番茄鐘時，背光恢復成使用中的設定檔。&lt;br&gt;MANUAL_DISPLAY 不在循環中間；從它按 BTN1 會回到時鐘（next_display_mode 的 default）。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff9e6;strokeColor=#d6b656;align=left;spacingLeft=8;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="680" width="1100" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="eb" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontFamily=Helvetica;fontSize=12;" edge="1" parent="1" source="boot" target="clock">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="BTN1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="clock" target="date">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="BTN1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="date" target="pomo">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="BTN1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pomo" target="div">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="BTN1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="div" target="cath">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="BTN1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cath" target="clock">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1370" y="420"/>
              <mxPoint x="150" y="420"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="ad" value="10 秒" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;dashed=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="date" target="clock">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="450" y="140"/>
              <mxPoint x="150" y="140"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="av" value="10 秒" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;dashed=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="div" target="clock">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1055" y="120"/>
              <mxPoint x="150" y="120"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="ac" value="4.5 秒" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;dashed=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cath" target="clock">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1370" y="100"/>
              <mxPoint x="150" y="100"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="em" value="BTN1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="manual" target="clock">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="auto15" value="每 15 分鐘" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;dashed=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="clock" target="cath">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="150" y="360"/>
              <mxPoint x="1370" y="360"/>
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="hibernate" name="休眠與待機">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="休眠與待機" style="text;html=1;fontSize=22;fontStyle=1;align=left;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="320" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="normal" value="HibernateState::Normal&lt;br&gt;依設定檔顯示" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="180" width="250" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="hib" value="Hibernating&lt;br&gt;DisplayMode::OFF&lt;br&gt;燈管與背光關閉" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="480" y="170" width="250" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="peek" value="Peek&lt;br&gt;時鐘模式&lt;br&gt;燈管亮度 50，背光關，5 秒" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="900" y="170" width="270" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="standby" value="待機&lt;br&gt;只有時鐘模式&lt;br&gt;燈管與背光都降到設定檔的 25%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="460" width="280" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="note" value="休眠時段要先啟用。開始與結束相同時，時段不會生效。同一天內是開始 ≤ 現在 &lt; 結束；若開始晚於結束，時段跨過午夜。&lt;br&gt;設定熱點開著時不評估休眠。進入熱點時若正在休眠或 Peek，會先把 HibernateState 拉回 Normal，燈管維持點亮。&lt;br&gt;離開時段時恢復設定檔。若當時不是 Normal，顯示模式回到時鐘。&lt;br&gt;網頁燈光預覽在休眠或 Peek 期間只記在記憶體，不會推到燈管。取消預覽時也不會在休眠中把燈管打開。&lt;br&gt;待機只在 Normal 而且是時鐘模式時累計。60 秒沒有按鍵才變暗。任一鍵恢復亮度，這次按鍵不換模式。日期、番茄鐘等模式不進入待機。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff9e6;strokeColor=#d6b656;align=left;spacingLeft=8;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="430" width="820" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="進入休眠時段" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="normal" target="hib">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="任一鍵，鬧鐘未響" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="hib" target="peek">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="5 秒到" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;dashed=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="peek" target="hib">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1035" y="330"/>
              <mxPoint x="605" y="330"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e4" value="再按，重設 5 秒" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;rounded=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=1;entryY=0.25;" edge="1" parent="1" source="peek" target="peek">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1035" y="120"/>
              <mxPoint x="1220" y="120"/>
              <mxPoint x="1220" y="195"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e5" value="離開時段" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;dashed=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="hib" target="normal">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="605" y="140"/>
              <mxPoint x="185" y="140"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e6" value="60 秒無按鍵" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="normal" target="standby">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="任一鍵，恢復亮度" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="standby" target="normal">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="40" y="510"/>
              <mxPoint x="40" y="220"/>
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="wifi" name="設定熱點">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="設定熱點" style="text;html=1;fontSize=22;fontStyle=1;align=left;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="280" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="idle" value="一般運作&lt;br&gt;記住進來前的顯示模式與休眠狀態" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="280" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="wait" value="WaitingClient&lt;br&gt;CONFIG_CODE&lt;br&gt;六管顯示四位連線碼&lt;br&gt;背光綠色呼吸" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="460" y="160" width="260" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="client" value="ClientConnected&lt;br&gt;回到時鐘&lt;br&gt;套用已存的燈光設定檔" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="880" y="170" width="260" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="exit" value="關閉熱點" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="620" y="420" width="160" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="restore" value="還原&lt;br&gt;進來前是休眠，而且現在仍在時段：回到休眠&lt;br&gt;進來前是時鐘或日期：回到時鐘&lt;br&gt;其他模式：還原進來前的模式" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="420" y="560" width="520" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="note" value="進入：長按 BTN1+BTN2 三秒。熱點名稱 NixieClock-XXXX，密碼 nixie2026，位址 192.168.8.8。&lt;br&gt;若進來時正在休眠或 Peek，先把休眠狀態改回 Normal，避免燈管被關掉。燈管亮度用設定檔；設定檔是 0 時用 200。背光是 RGB 120,255,120、亮度 200、呼吸。&lt;br&gt;手機一連上就切到時鐘與設定檔背光，熱點仍開著，設定頁可以繼續用。&lt;br&gt;關閉條件：再長按同一組合、頁面按完成並關閉、開滿 15 分鐘，或最後一個客戶端斷線後 15 秒。&lt;br&gt;熱點開著時，通過休眠與待機判斷之後的短按會被忽略，所以不會用 BTN1 換模式。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff9e6;strokeColor=#d6b656;align=left;spacingLeft=8;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="740" width="1280" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="長按 3 秒" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="idle" target="wait">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="有客戶端連上" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="wait" target="client">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="逾時、斷線或再長按" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="wait" target="exit">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="同上" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="client" target="exit">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontFamily=Helvetica;fontSize=12;" edge="1" parent="1" source="exit" target="restore">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="回到一般運作" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="restore" target="idle">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="180" y="615"/>
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="preview" name="燈光預覽">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="網頁燈光預覽與設定檔" style="text;html=1;fontSize=22;fontStyle=1;align=left;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="460" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="open" value="打開燈光頁&lt;br&gt;GET /api/settings&lt;br&gt;表單顯示使用中的設定檔" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="280" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="slide" value="拖曳顏色、亮度、效果&lt;br&gt;POST display，persist: false&lt;br&gt;約 60 ms 合併一次" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="250" width="300" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="hib" value="休眠或 Peek？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="90" y="430" width="260" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="hold" value="只記在記憶體&lt;br&gt;燈管維持關閉或 Peek" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="460" y="440" width="250" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="apply" value="立刻套用到燈管&lt;br&gt;不寫入 NVS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="100" y="590" width="240" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="save" value="儲存 1–4&lt;br&gt;persist: true，profiles.save_index&lt;br&gt;寫入該格、設成使用中、清掉預覽" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="820" y="120" width="320" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="swatch" value="點色塊&lt;br&gt;profiles.active_index&lt;br&gt;套用該格已存的外觀" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="820" y="260" width="320" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="leave" value="離開燈光頁，或瀏覽器關閉&lt;br&gt;POST preview.cancel&lt;br&gt;表單回到上次儲存的外觀&lt;br&gt;非休眠時，燈管也恢復該設定檔" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="820" y="400" width="360" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="btn" value="裝置上按 BTN2&lt;br&gt;先取消預覽，再切到下一組設定檔並寫入 NVS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="820" y="560" width="360" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="note" value="預覽會一直留著，直到取消、儲存，或 BTN2 換設定檔。SystemController 有 display_preview_timer_，回呼會取消預覽，但韌體沒有呼叫 esp_timer_start，所以不會在 2 秒後自己恢復。&lt;br&gt;表單上的「預覽中」是網頁自己的旗標。離開燈光頁時，即使裝置沒有把燈管改回去，網頁也會把滑桿設回上次儲存的值。&lt;br&gt;沒有板子時，用 python3 scripts/mock_web_ui.py 開同一份頁面。persist: false 只會印在終端機，重新整理後表單回到已儲存的設定。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff9e6;strokeColor=#d6b656;align=left;spacingLeft=8;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="720" width="1100" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontFamily=Helvetica;fontSize=12;" edge="1" parent="1" source="open" target="slide">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontFamily=Helvetica;fontSize=12;" edge="1" parent="1" source="slide" target="hib">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="hib" target="hold">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="hib" target="apply">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="submodes" name="番茄鐘與自動模式">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="番茄鐘、發散計、陰極防護、鬧鐘" style="text;html=1;fontSize=22;fontStyle=1;align=left;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="640" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="idle" value="PomodoroPhase::IDLE&lt;br&gt;顯示 002500&lt;br&gt;靜態橘 255,140,0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="230" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="work" value="WORK&lt;br&gt;呼吸橘，25 分鐘" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="360" y="120" width="210" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="brk" value="BREAK&lt;br&gt;呼吸綠 0,255,0，5 分鐘" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="660" y="120" width="230" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="pnote" value="只有等待中按 BTN0 會開始。工作或休息中再按 BTN0 沒有作用。BTN1 離開並恢復設定檔背光。BTN2 在番茄鐘中無效。工作與休息會一直交替，不會自己回時鐘。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff9e6;strokeColor=#d6b656;align=left;spacingLeft=8;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="850" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="jump" value="DivergencePhase::JUMPING&lt;br&gt;1.5 秒內六管各自亂跳" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="260" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="frozen" value="FROZEN&lt;br&gt;停在 0–199999" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="380" y="380" width="220" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="back" value="回到時鐘" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="680" y="395" width="140" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="dnote" value="從進入發散計算起滿 10 秒就回時鐘，含亂跳的 1.5 秒。BTN0 在凍結或亂跳中都會從頭再來。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff9e6;strokeColor=#d6b656;align=left;spacingLeft=8;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="490" width="780" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="cstep" value="陰極防護&lt;br&gt;六管同一數字，起點 0–9 隨機&lt;br&gt;每 300 ms 全部 +1（超過 9 回到 0）&lt;br&gt;走完 15 步後回時鐘" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="360" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="alarm" value="鬧鐘&lt;br&gt;DS3231 鬧鐘 1 觸發後循環播放曲目&lt;br&gt;最長 180 秒，或 BTN0 停止&lt;br&gt;BTN0 比休眠 Peek 先判斷" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="460" y="600" width="360" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="fade" value="數字淡入淡出只在時鐘、日期、番茄鐘，而且設定是 fade 時運作。&lt;br&gt;單管：穩定 → 淡出 450 ms → 全暗 80 ms → 淡入 450 ms → 穩定。&lt;br&gt;背光效果：static 是恆亮，breath 是呼吸，rainbow 是色相旋轉，off 是全關。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff9e6;strokeColor=#d6b656;align=left;spacingLeft=8;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="760" width="900" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="BTN0" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="idle" target="work">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="25 分鐘到" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;dashed=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="work" target="brk">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="5 分鐘到" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;dashed=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="brk" target="work">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="775" y="90"/>
              <mxPoint x="465" y="90"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e4" value="1.5 秒" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;dashed=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="jump" target="frozen">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="滿 10 秒" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;dashed=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="frozen" target="back">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="BTN0 重來" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="frozen" target="jump">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="490" y="350"/>
              <mxPoint x="170" y="350"/>
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
